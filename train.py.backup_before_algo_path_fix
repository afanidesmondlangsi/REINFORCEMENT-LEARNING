def load_parameter_overrides(params_input):
    """
    Load algorithm parameters from either a JSON file
    or an inline JSON string.
    """
    import json
    from pathlib import Path

    if params_input is None:
        return {}

    params_input = str(params_input).strip()

    if not params_input:
        raise ValueError("--params cannot be empty.")

    params_path = Path(params_input)

    if params_path.is_file():
        with open(params_path, "r", encoding="utf-8") as f:
            parameters = json.load(f)
    else:
        try:
            parameters = json.loads(params_input)
        except json.JSONDecodeError as e:
            raise ValueError(
                "Invalid JSON parameters: {}".format(e)
            )

    if not isinstance(parameters, dict):
        raise TypeError("--params must contain a JSON object.")

    return parameters


